<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Konadi Media - Portal Berita & Informasi</title>
</head>
<body style="margin: 0; background-color: #0b111e; font-family: Arial, sans-serif; color: #ffffff;">

    <!-- NAVBAR / HEADER -->
    <header style="background: #0e1721; border-bottom: 1px solid #1f293d; padding: 15px 20px; position: sticky; top: 0; z-index: 1000;">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
            <h1 style="margin: 0; font-size: 20px; color: #c9a86a;">Konadi Media</h1>
            <nav style="display: flex; gap: 20px;">
                <a href="#beranda" style="color: #ffffff; text-decoration: none; font-size: 14px;">Beranda</a>
                <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 14px;">Berita Gayo</a>
                <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 14px;">Tentang</a>
                <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 14px;">Kontak</a>
            </nav>
        </div>
    </header>

    <!-- LAYOUT UTAMA DUA KOLOM -->
    <div class="section-container" style="display: flex; gap: 30px; max-width: 1200px; margin: 40px auto; padding: 0 20px; flex-wrap: wrap;" id="beranda">
        
        <!-- KOLOM KIRI: KATEGORI & BERITA TERBARU -->
        <main style="flex: 2; min-width: 300px; display: flex; flex-direction: column; gap: 20px;">
            
            <!-- 1. KATEGORI: GAYO POPULER -->
            <section>
                <h3 style="margin-bottom: 10px; color: #ffffff; font-size: 16px; border-left: 3px solid #c9a86a; padding-left: 8px;">Gayo Populer</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="danauluttawar.html" class="card" style="text-decoration: none; display: flex; gap: 12px; align-items: center; background: #0e1721; border: 1px solid #1f293d; border-radius: 6px; padding: 8px; transition: 0.3s;">
                        <img src="danauluttawar.jpg" alt="Danau Lut Tawar" style="width: 90px; height: 60px; object-fit: cover; background: #0b111e; border-radius: 4px; flex-shrink: 0;">
                        <div style="display: flex; flex-direction: column; gap: 3px;">
                            <span style="background: #c9a86a; color: #0b111e; padding: 1px 5px; border-radius: 3px; font-weight: bold; font-size: 9px; width: fit-content;">Populer</span>
                            <h2 style="color: #ffffff; font-size: 13px; line-height: 1.2; margin: 0;">Danau Lut Tawar: Legenda dan Keindahan Dataran Tinggi Gayo</h2>
                            <p style="color: #94a3b8; font-size: 11px; line-height: 1.2; margin: 0; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">Menikmati keindahan alam panorama Danau Lut Tawar serta menyelisik legenda mendalam.</p>
                        </div>
                    </a>
                </div>
            </section>

            <!-- 2. KATEGORI: SEJARAH & ADAT -->
            <section>
                <h3 style="margin-bottom: 10px; color: #ffffff; font-size: 16px; border-left: 3px solid #c9a86a; padding-left: 8px;">Sejarah & Adat</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="sejarah-adat.html" class="card" style="text-decoration: none; display: flex; gap: 12px; align-items: center; background: #0e1721; border: 1px solid #1f293d; border-radius: 6px; padding: 8px; transition: 0.3s;">
                        <img src="putripukes.jpg" alt="Sejarah Adat" style="width: 90px; height: 60px; object-fit: cover; background: #0b111e; border-radius: 4px; flex-shrink: 0;">
                        <div style="display: flex; flex-direction: column; gap: 3px;">
                            <span style="background: #c9a86a; color: #0b111e; padding: 1px 5px; border-radius: 3px; font-weight: bold; font-size: 9px; width: fit-content;">Sejarah</span>
                            <h2 style="color: #ffffff; font-size: 13px; line-height: 1.2; margin: 0;">Legenda Putri Pukes & Asal-Usul Danau Laut Tawar</h2>
                            <p style="color: #94a3b8; font-size: 11px; line-height: 1.2; margin: 0; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">Konon pada zaman dahulu di Tanah Gayo, Aceh Tengah, hiduplah seorang putri bangsawan...</p>
                        </div>
                    </a>
                </div>
            </section>

            <!-- 3. KATEGORI: BUDAYA & SENI -->
            <section>
                <h3 style="margin-bottom: 10px; color: #ffffff; font-size: 16px; border-left: 3px solid #c9a86a; padding-left: 8px;">Budaya & Seni</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="#" class="card" style="text-decoration: none; display: flex; gap: 12px; align-items: center; background: #0e1721; border: 1px solid #1f293d; border-radius: 6px; padding: 8px; transition: 0.3s;">
                        <img src="kerawang.png" alt="Budaya Seni" style="width: 90px; height: 60px; object-fit: cover; background: #0b111e; border-radius: 4px; flex-shrink: 0;">
                        <div style="display: flex; flex-direction: column; gap: 3px;">
                            <span style="background: #c9a86a; color: #0b111e; padding: 1px 5px; border-radius: 3px; font-weight: bold; font-size: 9px; width: fit-content;">Budaya</span>
                            <h2 style="color: #ffffff; font-size: 13px; line-height: 1.2; margin: 0;">Mengenal Kekayaan Seni Tradisional & Kerawang Gayo</h2>
                            <p style="color: #94a3b8; font-size: 11px; line-height: 1.2; margin: 0; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">Mengenal kekayaan seni tradisional, tarian khas, dan kearifan lokal tanah Gayo.</p>
                        </div>
                    </a>
                </div>
            </section>

        </main>
        
        <!-- KOLOM KANAN: SIDEBAR STICKY (Video YouTube Pilihan) -->
        <aside style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 80px; height: fit-content;">
            
            <!-- Video 1 -->
            <div style="background: #121824; padding: 20px; border-radius: 12px; border: 1px solid #1f293d;">
                <p style="color: #ffffff; font-size: 14px; font-weight: bold; margin-bottom: 12px; border-bottom: 2px solid #d9a441; padding-bottom: 6px;">Ceramah Tengku Husaini Sasa</p>
                <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
                    <iframe src="https://www.youtube.com/embed/d7asE1bgWLc" 
                            title="YouTube video player" frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;">
                    </iframe>
                </div>
            </div>

            <!-- Video 2 -->
            <div style="background: #121824; padding: 20px; border-radius: 12px; border: 1px solid #1f293d;">
                <p style="color: #ffffff; font-size: 14px; font-weight: bold; margin-bottom: 12px; border-bottom: 2px solid #d9a441; padding-bottom: 6px;">Ceramah Tengku Irwansyah</p>
                <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
                    <iframe src="https://www.youtube.com/embed/kmYL-o4mWPs" 
                            title="YouTube video player" frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;">
                    </iframe>
                </div>
            </div>

            <!-- Video 3 -->
            <div style="background: #121824; padding: 20px; border-radius: 12px; border: 1px solid #1f293d;">
                <p style="color: #ffffff; font-size: 14px; font-weight: bold; margin-bottom: 12px; border-bottom: 2px solid #d9a441; padding-bottom: 6px;">Samadiah & Doa - Tengku Syakirin</p>
                <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
                    <iframe src="https://www.youtube.com/embed/mw3RlcC-_aI" 
                            title="YouTube video player" frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;">
                    </iframe>
                </div>
            </div>

        </aside>

    </div>

